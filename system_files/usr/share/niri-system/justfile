# Existing entry point for the opt-in development schedule
[group('System')]
configure-snapshots-dev: configure-snapshot-schedule

# Opt in to a 15-minute system timeline schedule and home retention
[group('System')]
configure-snapshot-schedule: _validate-snapshot-config
    #!/usr/bin/bash
    set -euo pipefail
    override=/etc/systemd/system/snapper-timeline.timer.d/dev-machine.conf
    if [[ -e "$override" || -L "$override" ]]; then
        echo "Error: $override already exists; inspect it manually, no settings changed." >&2
        exit 1
    fi
    echo "Set the system timeline timer to every 15 minutes (affects all eligible configs)."
    echo "Set home retention to 24 hourly, 7 daily, 4 weekly, 0 monthly/yearly; cleanup may prune snapshots."
    echo "Hourly retention means hourly representatives, not 24 consecutive 15-minute snapshots."
    echo "Review other timer drop-ins with: systemctl cat snapper-timeline.timer"
    echo "Reloading changes an already-active timer's schedule; inactive timers stay inactive."
    if ! read -rp "Apply schedule and retention? [y/N]: " confirm || [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        exit 0
    fi
    mkdir -p "${override%/*}"
    (set -o noclobber; printf '%s\n' '[Timer]' 'OnCalendar=' 'OnCalendar=*:0/15' > "$override")
    snapper -c home set-config TIMELINE_LIMIT_HOURLY=24 TIMELINE_LIMIT_DAILY=7 TIMELINE_LIMIT_WEEKLY=4 TIMELINE_LIMIT_MONTHLY=0 TIMELINE_LIMIT_YEARLY=0
    systemctl --system daemon-reload
    echo "Schedule configured. Timer activation is a separate choice below."
    just --justfile "{{source_file()}}" enable-snapshot-timers

# Download latest virtio-win drivers ISO for Windows VMs
[group('Virtualization')]
download-virtio-win:
    #!/usr/bin/bash
    set -euo pipefail
    ISO_DIR="${HOME}/.local/share/libvirt/images"
    mkdir -p "$ISO_DIR"
    LATEST_URL="https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso"
    echo "Downloading latest virtio-win ISO..."
    curl -L -o "$ISO_DIR/virtio-win.iso" "$LATEST_URL"
    echo ""
    echo "Downloaded to: $ISO_DIR/virtio-win.iso"
    echo "Attach this ISO to Windows VMs to install virtio drivers."

# Add current user to libvirt group for passwordless VM management
[group('Virtualization')]
setup-libvirt:
    #!/usr/bin/bash
    set -euo pipefail
    if groups | grep -q libvirt; then
        echo "Already in libvirt group!"
    else
        sudo usermod -aG libvirt "$USER"
        echo "Added $USER to libvirt group."
        echo "Log out and back in for changes to take effect."
    fi

# Start libvirt default network
[group('Virtualization')]
virt-network-start:
    sudo virsh net-start default 2>/dev/null || echo "Network already running"
    sudo virsh net-autostart default
    @echo "Default network is running and set to autostart."

# Show VM status
[group('Virtualization')]
virt-status:
