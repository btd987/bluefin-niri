# Niri compositor and native Noctalia shell recipes

# Switch to Niri session
[group('Desktop')]
niri-session:
    @echo "Log out and select 'Niri' from the session menu in your existing display manager"

# Reload Niri configuration
[group('Desktop')]
niri-reload:
    niri msg action reload-config-or-panic

# Show Niri version info
[group('Desktop')]
niri-version:
    @niri --version
    @echo ""
    @rpm -q noctalia || echo "Noctalia not installed"

# Install Podman Desktop system-wide with native Flatpak confirmation
[group('Desktop')]
setup-podman-desktop:
    #!/usr/bin/bash
    set -euo pipefail
    if ! command -v flatpak >/dev/null 2>&1; then
        echo "Error: flatpak is required to install Podman Desktop." >&2
        exit 1
    fi
    flatpak install --system https://dl.flathub.org/repo/appstream/io.podman_desktop.PodmanDesktop.flatpakref

# Enroll DevPod's Docker-compatible provider with rootless Podman, without changing defaults
[group('Desktop')]
setup-devpod-podman:
    #!/usr/bin/bash
    set -euo pipefail
    if [[ $EUID -eq 0 ]]; then
        echo "Error: run as your regular user, without sudo." >&2
        exit 1
    fi
    for tool in devpod podman python3; do
        command -v "$tool" >/dev/null || { echo "Error: $tool is required." >&2; exit 1; }
    done
    providers=$(devpod provider list --output json)
    exists=$(python3 -c 'import json,sys; data=json.load(sys.stdin); assert isinstance(data,dict); print("yes" if "podman" in data else "no")' <<< "$providers")
    if [[ "$exists" == yes ]]; then
        echo "Provider 'podman' already exists; no options or defaults changed. Inspect: devpod provider options podman"
        echo "If initialization or correction is needed, review the existing provider first, then explicitly run: devpod provider set-options podman --option DOCKER_PATH=podman"
        exit 0
    fi
    podman info >/dev/null
    echo "Add provider 'podman' using the upstream Docker-compatible provider and DOCKER_PATH=podman."
    echo "This downloads provider code and performs provider initialization as your user; no Docker engine, socket, workspace, or dotfiles are configured."
    echo "Existing providers and the default selection are preserved."
    if read -rp "Add this provider? [y/N]: " confirm && [[ "$confirm" =~ ^[Yy]$ ]]; then
        devpod provider add docker --name podman --option DOCKER_PATH=podman --use=false
        if devpod provider set-options podman --option DOCKER_PATH=podman; then
            echo "Provider 'podman' initialized; default selection unchanged."
        else
            status=$?
            echo "Error: provider added but initialization failed; it was not removed. Inspect: devpod provider options podman" >&2
            echo "Review before explicitly retrying: devpod provider set-options podman --option DOCKER_PATH=podman" >&2
            exit "$status"
        fi
    fi

# Initialize snapper for btrfs snapshots (run once after install)
# Note: On Fedora Atomic, only /var/home is a btrfs subvolume.
# System rollback is handled by bootc/ostree, not btrfs snapshots.
[group('System')]
setup-snapshots:
    #!/usr/bin/bash
    set -euo pipefail
    if [[ $EUID -ne 0 ]]; then
        echo "Run with sudo: sudo just --justfile /usr/share/niri-system/justfile setup-snapshots"
        exit 1
    fi
    echo "Setting up snapper for /var/home snapshots..."
    configs=$(snapper --csvout --no-headers list-configs --columns config)
    if ! grep -Fxq home <<< "$configs"; then
        snapper -c home create-config /var/home
    fi
    config=$(snapper --csvout --no-headers -c home get-config --columns key,value)
    if ! grep -Fxq 'SUBVOLUME,/var/home' <<< "$config"; then
        echo "Error: Snapper config 'home' must target /var/home; no existing settings were changed." >&2
        exit 1
    fi
    echo ""
    echo "Snapper config 'home' is configured for /var/home."
    echo "Automatic timeline snapshots require TIMELINE_CREATE=yes and an active snapper-timeline.timer."
    echo "Note: System rollback uses 'bootc rollback', not btrfs snapshots."
    echo "Use 'btrfs-assistant' for GUI or 'just --justfile /usr/share/niri-system/justfile list-snapshots' to view."
    if read -rp "Review automatic snapshot activation now? [y/N]: " confirm && [[ "$confirm" =~ ^[Yy]$ ]]; then
        just --justfile "{{source_file()}}" enable-snapshot-timers
    fi

# Validate existing configuration without creating or changing it
[private]
_validate-snapshot-config:
    #!/usr/bin/bash
    set -euo pipefail
    if [[ $EUID -ne 0 ]]; then
        echo "Error: run this snapshot recipe with sudo." >&2
        exit 1
    fi
    config=$(snapper --csvout --no-headers -c home get-config --columns key,value)
    if ! grep -Fxq 'SUBVOLUME,/var/home' <<< "$config"; then
        echo "Error: Snapper config 'home' must target /var/home; run setup-snapshots first." >&2
        exit 1
    fi

# Explicitly activate automatic snapshots and retention cleanup
[group('System')]
enable-snapshot-timers: _validate-snapshot-config
    #!/usr/bin/bash
    set -euo pipefail
    echo "Enable TIMELINE_CREATE=yes for home and enable/start the system Snapper timeline and cleanup timers."
    echo "These timers affect ALL eligible Snapper configs. Cleanup can delete snapshots under existing retention policies."
    echo "Persistent timers may run immediately. Existing schedules and retention settings are preserved."
    if read -rp "Activate snapshots and cleanup? [y/N]: " confirm && [[ "$confirm" =~ ^[Yy]$ ]]; then
        snapper -c home set-config TIMELINE_CREATE=yes
        systemctl --system enable --now snapper-timeline.timer snapper-cleanup.timer
    fi

# List all btrfs snapshots
[group('System')]
list-snapshots:
    @snapper -c home list 2>/dev/null || echo "No config (run: sudo just --justfile /usr/share/niri-system/justfile setup-snapshots)"

# Create manual snapshot with description
[group('System')]
snapshot desc="manual":
    sudo snapper -c home create -d "{{desc}}"
    @echo "Created snapshot: {{desc}}"

# Open btrfs-assistant GUI
[group('System')]
btrfs-assistant:
    @btrfs-assistant

# Enroll an opt-in named Borg backup; preserve each argument without shell interpolation
[group('System')]
[positional-arguments]
setup-backup *args:
    #!/usr/bin/bash
    set -euo pipefail
    exec sudo setup-backup "$@"

# Inspect a named backup's system timer and service without starting either
[group('System')]
[positional-arguments]
backup-status name:
    #!/usr/bin/bash
    set -euo pipefail
    export LC_ALL=C
    if [[ ! "$1" =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
        echo "Error: backup name must be 1-32 lowercase letters/digits/hyphens, starting with a letter." >&2
        exit 1
    fi
    exec sudo systemctl --system --no-pager status "backup@$1.timer" "backup@$1.service"

# Read block devices, mounts, and optional already-imported ZFS storage
[group('System')]
storage-status:
    #!/usr/bin/bash
    set -uo pipefail
    result=0
    lsblk -f || result=$?
    findmnt -r || result=$?
    if command -v zpool >/dev/null 2>&1; then
        zpool status || result=$?
    fi
    if command -v zfs >/dev/null 2>&1; then
        zfs list -o name,type,used,available,mountpoint || result=$?
    fi
    exit "$result"

# Opt in to maintenance for existing ZFS storage on the Fedora candidate only
[group('System')]
[positional-arguments]
configure-zfs name="default":
    #!/usr/bin/bash
    set -euo pipefail
    if [[ ! -f /usr/libexec/fedora-zfs ]]; then
        echo "Error: configure-zfs is Fedora-only; this image does not provide /usr/libexec/fedora-zfs." >&2
        exit 1
    fi
    exec sudo python3 -I /usr/libexec/fedora-zfs enroll "$1"

