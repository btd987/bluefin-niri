#!/usr/bin/bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "Run with sudo: sudo ujust setup-home-backup"
    exit 1
fi

md_device=/dev/md/home-backup
mapping=home-backup
key_file=/etc/cryptsetup-keys.d/home-backup.key
mount_point=/var/mnt/home-backup
borg_passphrase=/etc/borgmatic/home.passphrase

[[ -b "$md_device" ]] || {
    echo "$md_device does not exist." >&2
    exit 1
}
cryptsetup isLuks "$md_device" || {
    echo "$md_device is not a LUKS volume." >&2
    exit 1
}
[[ -r "$key_file" ]] || {
    echo "$key_file is missing." >&2
    exit 1
}

keyslot_count=$(cryptsetup luksDump "$md_device" | sed -n '/^Keyslots:/,/^Tokens:/p' | grep -c '^  [0-9][0-9]*:')
if ((keyslot_count < 2)); then
    echo "Add a recovery passphrase. Keep it independently of this computer."
    cryptsetup luksAddKey "$md_device" --key-file "$key_file"
fi

mkdir -p /etc/borgmatic /etc/borgmatic.d "$mount_point"
if [[ ! -e "$borg_passphrase" ]]; then
    read -rsp "Borg repository passphrase: " passphrase
    echo
    read -rsp "Confirm Borg repository passphrase: " confirmation
    echo
    [[ "$passphrase" == "$confirmation" ]] || {
        echo "Borg passphrases did not match." >&2
        exit 1
    }
    umask 077
    printf '%s' "$passphrase" > "$borg_passphrase"
    unset passphrase confirmation
fi

mdadm --detail --scan > /etc/mdadm.conf
luks_uuid=$(cryptsetup luksUUID "$md_device")
sed -i '/^home-backup[[:space:]]/d' /etc/crypttab
printf 'home-backup UUID=%s %s luks,nofail\n' "$luks_uuid" "$key_file" >> /etc/crypttab

cryptsetup status "$mapping" >/dev/null 2>&1 || cryptsetup open --key-file "$key_file" "$md_device" "$mapping"
filesystem_uuid=$(blkid -s UUID -o value "/dev/mapper/$mapping")
sed -i '\|[[:space:]]/var/mnt/home-backup[[:space:]]|d' /etc/fstab
printf 'UUID=%s %s ext4 noatime,nofail,x-systemd.device-timeout=30 0 2\n' "$filesystem_uuid" "$mount_point" >> /etc/fstab

template=/usr/share/bluefin-niri/home-borgmatic.yaml
[[ -r "$template" ]] || template=/usr/local/share/bluefin-niri/home-borgmatic.yaml
install -m 0600 "$template" /etc/borgmatic.d/home.yaml

systemctl daemon-reload
mountpoint -q "$mount_point" || mount "$mount_point"
mkdir -p "$mount_point/borg"
chmod 0700 "$mount_point"

if [[ -x /usr/bin/borgmatic ]]; then
    borgmatic=/usr/bin/borgmatic
else
    export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
    borgmatic=/home/linuxbrew/.linuxbrew/bin/borgmatic
fi
"$borgmatic" --config /etc/borgmatic.d/home.yaml config validate
if [[ ! -e "$mount_point/borg/config" ]]; then
    "$borgmatic" --config /etc/borgmatic.d/home.yaml repo-create
fi

systemctl disable --now snapper-timeline.timer 2>/dev/null || true
systemctl enable --now home-borgmatic.timer home-backup-raid-check.timer

echo "Home backup configured. The first backup will run after RAID synchronization completes."
