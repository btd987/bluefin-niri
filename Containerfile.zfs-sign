# No publication. The only output is six signed RPMs and public metadata.
ARG ZFS_RPM_IMAGE=localhost/zfs-rpms-test-proof:latest
FROM ${ZFS_RPM_IMAGE} AS zfs-rpm-artifacts
FROM quay.io/fedora/fedora-bootc:44@sha256:d6481b291e960abb02a346294dcac2818df8dfe2b1bc51d1ae8fa53a15718756 AS zfs-signer
RUN dnf5 -y --exclude='kernel*' install rpm-sign gnupg2 && dnf5 clean all
COPY scripts/sign-zfs-rpms.sh /tmp/sign-zfs-rpms.sh
ARG ZFS_RPM_SIGNING_FINGERPRINT
RUN --mount=type=bind,from=zfs-rpm-artifacts,source=/,target=/run/zfs-rpms \
    --mount=type=secret,id=zfs_rpm_signing_key,required=true \
    --mount=type=tmpfs,target=/run/zfs-signing \
    bash /tmp/sign-zfs-rpms.sh
FROM scratch AS zfs-signed-rpms
COPY --from=zfs-signer /out/ /
